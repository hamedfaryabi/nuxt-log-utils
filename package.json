{
  "name": "nuxt-log-utils",
  "version": "0.2.1",
  "description": "A flexible, extensible logger module for Nuxt 3/4 with masking, file rotation, per-level config, and transport extensions.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "author": "Hamed Faryabi <hamed.faryabi9@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hamedfaryabi/nuxt-log-utils.git"
  },
  "homepage": "https://github.com/hamedfaryabi/nuxt-log-utils#readme",
  "bugs": {
    "url": "https://github.com/hamedfaryabi/nuxt-log-utils/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "logger",
    "logging",
    "nuxt4",
    "nuxt3",
    "log",
    "transport",
    "masking",
    "consola"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs",
      "default": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "nuxt-module-build build",
    "dev": "npm run dev:prepare && nuxt dev playground",
    "dev:build": "nuxt build playground",
    "dev:prepare": "nuxt-module-build build --stub && nuxt-module-build prepare && nuxt prepare playground",
    "release": "npm run lint && npm run test && npm run prepack && changelogen --release && npm publish && git push --follow-tags",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vue-tsc --noEmit && cd playground && vue-tsc --noEmit"
  },
  "dependencies": {
    "@nuxt/kit": "^4.3.1",
    "consola": "^3.4.2",
    "defu": "^6.1.4",
    "serialize-javascript": "^7.0.3"
  },
  "peerDependencies": {
    "nuxt": "^3.0.0 || ^4.0.0"
  },
  "devDependencies": {
    "@nuxt/devtools": "^3.2.1",
    "@nuxt/eslint-config": "^1.15.1",
    "@nuxt/module-builder": "^1.0.2",
    "@types/node": "latest",
    "changelogen": "^0.6.2",
    "eslint": "^10.0.0",
    "nuxt": "^4.3.1",
    "typescript": "~5.9.3",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  }
}
